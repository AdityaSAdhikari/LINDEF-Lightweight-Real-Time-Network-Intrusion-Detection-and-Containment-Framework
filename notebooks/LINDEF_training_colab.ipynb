RANDOM_STATE = 42
MAX_SAMPLE_ROWS = 200_000
CHUNK_SIZE = 100_000
MIN_CLASS_COUNT = 6

CIC_EXTRACT_DIR = "/content/cic_data"

NSL_TRAIN_FILE = "NSL-KDD(training) - KDDTrain+.csv"
NSL_TEST_FILE = "NSL-KDD(testing) - KDDTest+.csv"
UNSW_TRAIN_FILE = "UNSW-NB15 (training) - UNSW_NB15_training-set (1).csv"
UNSW_TEST_FILE = "UNSW-NB15 (testing) - UNSW_NB15_testing-set (1).csv"

BINARY_MODEL_FILE = "binary_model.pkl"
MULTI_MODEL_FILE = "class_model.pkl"
SCALER_FILE = "scaler.pkl"
LABEL_ENCODER_FILE = "labelEncoder.pkl"
FEATURE_COLUMNS_FILE = "feature_columns.pkl"
FEATURE_MEDIANS_FILE = "feature_medians.npy"
SIMULATION_TEST_FILE = "simulation_test.csv"

NORMAL_LABELS = {"NORMAL", "BENIGN"}

MODEL_DROP_COLUMNS = [
    "binary_label",
    "multi_label",
    "attack_type",
    "Label",
    "attack_cat",
    "dataset",
    "Destination Port",
]

LEAKAGE_COLUMN_KEYWORDS = [
    "Flow ID",
    "Source IP",
    "Destination IP",
    "Timestamp",
]

